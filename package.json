{
	"name": "proxdocs",
	"version": "2.0.0",
	"private": true,
	"type": "module",
	"description": "Documentation and a modular generator for modern web proxies",
	"keywords": [
		"Proxy",
		"tutorial",
		"scramjet",
		"documentation",
		"night"
	],
	"author": {
		"name": "crllect",
		"email": "crllect@proton.me",
		"url": "https://crllect.dev"
	},
	"license": "AGPL-3.0-only",
	"scripts": {
		"start": "node site/server.js",
		"dev": "node scripts/build-site.js && node site/server.js",
		"build": "node builder/cli.js",
		"build:site": "node scripts/build-site.js",
		"preview:site": "npm run build:site && npx wrangler pages dev dist",
		"examples": "node scripts/generate-examples.js",
		"check": "node scripts/check.js",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"engines": {
		"node": ">=22.13"
	},
	"dependencies": {
		"marked": "^15.0.7",
		"typescript": "5.9.2"
	},
	"devDependencies": {
		"prettier": "3.6.2",
		"wrangler": "^4"
	},
	"prettier": {
		"tabWidth": 4,
		"useTabs": true,
		"semi": true,
		"singleQuote": false,
		"trailingComma": "none",
		"bracketSpacing": true,
		"bracketSameLine": false,
		"arrowParens": "avoid",
		"requirePragma": false,
		"insertPragma": false,
		"proseWrap": "always",
		"endOfLine": "lf"
	}
}
