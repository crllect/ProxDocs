{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/**",
          "node_modules/@titaniumnetwork-dev/ultraviolet/**",
          "node_modules/@mercuryworkshop/bare-mux/**",
          "node_modules/@mercuryworkshop/bare-as-module3/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
