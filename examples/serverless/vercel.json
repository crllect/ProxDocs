{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "public/**",
          "node_modules/@mercuryworkshop/scramjet/**",
          "node_modules/@mercuryworkshop/scramjet-controller/**",
          "node_modules/@mercuryworkshop/scramjet-utils/**",
          "node_modules/@mercuryworkshop/bare-transport/**"
        ]
      }
    }
  ],
  "routes": [
    {
      "src": "/(.*)",
      "dest": "server.js"
    }
  ]
}
